//$<AutoDeclare>
// DO NOT EDIT THIS SECTION MANUALLY
Var
   MODXInSysEx : MidiInBlock
   LiveSetSelectorBank, LiveSetSelectorPage, LiveSetSelectorCol, LiveSetSelectorRow : Widget
   PartLabel01 : Widget
   PartLabel02 : Widget
   PartLabel03 : Widget
   PartLabel04 : Widget
   PartLabel05 : Widget
   PartLabel06 : Widget
   PartLabel07 : Widget
   PartLabel08 : Widget
   PerformanceNameWidget : Widget
   SendCurrentVolumeValues : Widget
//$</AutoDeclare>

Var
   PerformanceNameBytes : Integer[20]
   PerformanceNameCharReceived : Boolean[20]
   CurrentPerformanceName : String = ""

   PartLabelWidgets : Widget Array = [
      PartLabel01, PartLabel02, PartLabel03, PartLabel04,
      PartLabel05, PartLabel06, PartLabel07, PartLabel08
   ]
   PartIsSwitchedOn : Boolean Array = [
       true, true, true, true,
       true, true, true, true
   ]
   PartNames : String Array = [
      "", "", "", "",
      "", "", "", ""
   ]
   LiveSetSelectorsCachedValues : Integer Array = [
      ScaleRange(GetWidgetValue(LiveSetSelectorBank), 1, 8),
      ScaleRange(GetWidgetValue(LiveSetSelectorPage), 1, 16),
      ScaleRange(GetWidgetValue(LiveSetSelectorRow), 1, 4),
      ScaleRange(GetWidgetValue(LiveSetSelectorCol), 1, 4)
   ]

   numberOfSupportedParts : Integer = Size(PartLabelWidgets)


Function GetPerformanceSlotBasedLabel() Returns String
   Var
      bank : Integer = ScaleRange(GetWidgetValue(LiveSetSelectorBank), 1, 8)
      page : Integer = ScaleRange(GetWidgetValue(LiveSetSelectorPage), 1, 16)
      col : Integer = ScaleRange(GetWidgetValue(LiveSetSelectorCol), 0, 3)
      row : Integer = ScaleRange(GetWidgetValue(LiveSetSelectorRow), 1, 4)
      colStr : String
   
   Select
      col == 0 Do colStr = "A"
      col == 1 Do colStr = "B"
      col == 2 Do colStr = "C"
      col == 3 Do colStr = "D"
   End

   result = "Bank " + IntToString(bank)
          + " | Page " + IntToString(page)
          + " | Slot " + colStr + IntToString(row)
End


Function ClearCurrentPerformanceNameBuffer()
   // Clear buffers used to receive partial updated to requested Performance Names.
   Var
      i : Integer

   For i = 0; i <= 19; i = i + 1 Do
      PerformanceNameBytes[i] = 0x20
      PerformanceNameCharReceived[i] = false
   End

   CurrentPerformanceName = ""
End


Function HaveCompletePerformanceName() Returns Boolean
   // Return whether all bytes expected for a performance name have been received.
   Var
      i : Integer

   result = true

   For i = 0; i <= 19; i = i + 1 Do
      If Not PerformanceNameCharReceived[i] Then
         result = false
      End
   End
End


Function RebuildCurrentPerformanceName()
   // Build full performance name from bytes buffered from separate SysEx messages.
   Var
      i : Integer
      c : Integer
      s : String = ""

   For i = 0; i <= 19; i = i + 1 Do
      If PerformanceNameCharReceived[i] Then
         c = PerformanceNameBytes[i]

         If c >= 0x20 And c <= 0x7E Then
            s = s + ByteToChar(c)
         End
      End
   End

   CurrentPerformanceName = TrimString(s)
End


Function ParsePerformanceNameReplyIfApplicable(sx : SysexMessage)
   // Parse SysEx reply, look for "Current Performance Name Char" in it, and update
   // PerformanceNameBytes & PerformanceNameCharReceived is applicable. Upon receiving
   // all expected chars, set corresponding full name to PerformanceNameWidget Widget
   // and clear PerformanceNameBytes & PerformanceNameCharReceived buffers.
   //
   // Observed SysEx msg format:
   // (the MODX sends one such message for each character in the current Performance name)
   // F0 43 10 7F 1C 07 30 40 oo dd F7
   //
   // In this layout:
   //   sx[6] = 0x30           --> Data block identifier
   //   sx[7] = 0x40           --> Offset/field selector for the Performance Name area
   //   sx[8] = oo, 0x00..0x13 --> Character offset within the Performance Name,
   //                              i.e. character index 0..19, for 20 characters total
   //   sx[9] = dd             --> Character byte, interpreted as ASCII
   // ------------------------------------------------------------
   Var
      msgBlock : Integer
      charIndexOffset, perfNameAreaOffset : Integer
      dataByte : Integer

   If SM_Length(sx) >= 11 Then
      msgBlock = SM_GetValue(sx, 6)
      perfNameAreaOffset = SM_GetValue(sx, 7)
      charIndexOffset = SM_GetValue(sx, 8)

      If (msgBlock == 0x30) And (perfNameAreaOffset == 0x40) And (charIndexOffset >= 0x00) And (charIndexOffset <= 0x13) Then
         dataByte = SM_GetValue(sx, 9)

         PerformanceNameBytes[charIndexOffset] = dataByte
         PerformanceNameCharReceived[charIndexOffset] = true

         If HaveCompletePerformanceName() Then
            RebuildCurrentPerformanceName()
            CurrentPerformanceName = CurrentPerformanceName + "[nl]" + GetPerformanceSlotBasedLabel()
            SetWidgetLabel(PerformanceNameWidget, CurrentPerformanceName)
            ClearCurrentPerformanceNameBuffer()
         End
      End
   End
End


Function UpdatePartLabel(partIndex : Integer)
   // Set widget label to part name if part is switched on, or to empty otherwise.
   If PartIsSwitchedOn[partIndex] Then
      SetWidgetLabel(PartLabelWidgets[partIndex], PartNames[partIndex])
   Else
      SetWidgetLabel(PartLabelWidgets[partIndex], "")
   End
End


Function ParsePerformancePartSwitchStatusIfApplicable(sx : SysexMessage)
   // Parse SysEx reply, look for "Single-parameter Part Switch" in it, and update PartIsSwitchedOn if applicable.
   //
   // Observed SysEx msg format:
   // F0 43 10 7F 1C 07 31 pp 16 dd F7
   //
   // In this layout:
   //   sx[6] = 0x31              --> Data block identifier
   //   sx[7] = pp                --> Performance Part index, 0..15
   //   sx[8] = 0x16              --> Offset/field selector within the block for that Part;
   //                                 observed to correspond to the Part Switch on/off status
   //   sx[9] = 0x00/0x01         --> Data byte: 0x00 = Off, 0x01 = On
   Var
      msgBlock : Integer
      partIndex : Integer
      partOffset : Integer
      dataByte : Integer
      maxIndex : Integer = numberOfSupportedParts - 1

   If SM_Length(sx) >= 11 Then
      msgBlock = SM_GetValue(sx, 6)
      partIndex = SM_GetValue(sx, 7)
      partOffset = SM_GetValue(sx, 8)

      If (msgBlock == 0x31) And (partIndex >= 0) And (partIndex <= maxIndex) And (partOffset == 0x16) Then
         dataByte = SM_GetValue(sx, 9)
         PartIsSwitchedOn[partIndex] = dataByte != 0
         //UpdatePartLabel(partIndex)
      End
   End
End


Function ExtractPartNameFromNamePacket(sx : SysexMessage) Returns String
   // Helper function to extract name of a performance part from a SysEx data packet.
   Var
      i : Integer
      b : Integer
      sysExLength : Integer = SM_Length(sx)
      s : String = ""

   // Observed MODX name field:
   // byte 11 starts the name.
   // name appears to be 20 bytes, space padded.
   For i = 11; i < 31; i = i + 1 Do
      If i < sysExLength - 2 Then
         b = SM_GetValue(sx, i)
         If IsAsciiChar(b) Then
            s = s + ByteToChar(b)
         End
      End
   End

   result = TrimString(s)
End


Function ParsePerformancePartNameIfApplicable(sx : SysexMessage)
   // Parse SysEx reply, look for bulk-dump for "Part Name" in it, and update PartNames if applicable.
   //
   // Observed SysEx msg format:
   // F0 43 00 7F 1C 00 len 07 31 pp 00 <name...> checksum F7
   //
   // In this layout:
   //   sx[8]  = 0x31        --> Data block identifier
   //   sx[9]  = pp          --> Performance Part index, 0..15
   //   sx[10] = 0x00        --> Offset/field selector within the block for that Part.
   //                            For this observed bulk-dump reply, offset 0x00
   //                            identifies the Part Name field.
   Var
      msgBlock : Integer
      partIndex : Integer
      partOffset : Integer
      partName : String
      maxIndex : Integer = numberOfSupportedParts - 1


   If SM_Length(sx) > 31 Then
      msgBlock = SM_GetValue(sx, 8)
      partIndex = SM_GetValue(sx, 9)
      partOffset = SM_GetValue(sx, 10)

      If (msgBlock == 0x31) And (partIndex >= 0) And (partIndex <= maxIndex) And (partOffset == 0) Then
         partName = ExtractPartNameFromNamePacket(sx)
         PartNames[partIndex] = partName
         UpdatePartLabel(partIndex)
      End
   End
End


//---------------------------------------------------------------------
Initialization
   //OpenLogWindow()
   SetWidgetValue(SendCurrentVolumeValues, 1)
End


On WidgetValueChanged(w : Widget, index : Integer, newValue : Double)
    From LiveSetSelectorBank, LiveSetSelectorPage, LiveSetSelectorRow, LiveSetSelectorCol

   var
       partIndex : Integer
       PerformanceName : String
       cachedOldValue : Integer = LiveSetSelectorsCachedValues[index]
       actualNewValue : Integer

   Select
      index==1 do actualNewValue = ScaleRange(newValue, 1, 8)
      index==2 do actualNewValue = ScaleRange(newValue, 1, 16)
      index==3 do actualNewValue = ScaleRange(newValue, 1, 4)
      index==4 do actualNewValue = ScaleRange(newValue, 1, 4)
   End


   If actualNewValue != cachedOldValue Then
      // Make sure to start by updating modified cached values
      LiveSetSelectorsCachedValues[index] = actualNewValue

      SetWidgetLabel(PerformanceNameWidget, GetPerformanceSlotBasedLabel())

      // Reset part names by default, then let the "On SysexEvent" do the rename when applicable
      For partIndex=0; partIndex<8; partIndex=partIndex+1 Do
         SetWidgetLabel(PartLabelWidgets[partIndex], "")
      End
   End
End


On SysexEvent(sx : SysexMessage) From MODXInSysEx
   If IsMODXSysEx(sx) Then
      ParsePerformanceNameReplyIfApplicable(sx)
      ParsePerformancePartSwitchStatusIfApplicable(sx)
      ParsePerformancePartNameIfApplicable(sx)
   End
End

// Called when switching variations
On Variation(oldVariation : integer, newVariation : integer)
    SetWidgetValue(SendCurrentVolumeValues, 1)
End
