Function IsYamahaSysEx(sx : SysexMessage) Returns Boolean
   // Return whether the SysEx is an Yamaha-style SysEx.
    result = SM_Length(sx) >= 3
             And SM_GetValue(sx, 0) == 0xF0
             And SM_GetValue(sx, 1) == 0x43
             And SM_GetValue(sx, SM_Length(sx) - 1) == 0xF7
End


Function IsMODXSysEx(sx : SysexMessage) Returns Boolean
    // Return whether the SysEx is a MODX-style SysEx.
    result = SM_Length(sx) >= 6
             And IsYamahaSysEx(sx)
             And SM_GetValue(sx, 3) == 0x7F
             And SM_GetValue(sx, 4) == 0x1C
End