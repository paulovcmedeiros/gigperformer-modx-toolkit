//----------------------------------------------------------
// Define reusable MainSwitch and CH1-CH16 ON/OFF switches,
// and utility function `MODXTK_ChannelIsAllowed`.
//----------------------------------------------------------
Var
    MainSwitch: Discrete Parameter "OFF", "ON" = "ON"
    CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8,
    CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16 : Discrete Parameter "OFF", "ON" = "ON"


Function MODXTK_ResetChannelSwitches(newValue : String)
    Var
        i : Integer
        channelSwitches : Discrete Array = [
            CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8,
            CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16
        ]

    For i=0; i<Size(channelSwitches); i=i+1 Do
        channelSwitches[i] = newValue
    End
End


Function MODXTK_ChannelIsAllowed(channel : Integer) Returns Boolean
    Var
        index : Integer = channel - 1
        channelSwitches : Discrete Array = [
            CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8,
            CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16
        ]

    result = (MainSwitch == "ON") And (channelSwitches[index] == "ON")
End
