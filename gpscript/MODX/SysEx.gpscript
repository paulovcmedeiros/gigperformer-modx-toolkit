//----------------------------------------------------------
// Functions related to general MODX SysEx message handling
//----------------------------------------------------------
Function MODXTK_IsMODXSysEx(sx : SysexMessage) Returns Boolean
    // Return whether the SysEx is a MODX-style SysEx.
    result = SM_Length(sx) >= 6
    And MODXTK_IsYamahaSysEx(sx)
    And SM_GetValue(sx, 3) == 0x7F
    And SM_GetValue(sx, 4) == 0x1C
End


Function MODXTK_IsMODXBulkDump(sx : SysexMessage) Returns Boolean
    // MODX bulk-dump replies are also valid bulk-write messages if echoed back
    // to the synth, so they should not be forwarded casually.
    result = MODXTK_IsMODXSysEx(sx)
    And SM_Length(sx) >= 8
    And SM_GetValue(sx, 2) >= 0x00
    And SM_GetValue(sx, 2) <= 0x0F
End
