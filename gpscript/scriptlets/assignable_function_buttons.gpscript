var
    AF_Button: Subrange Parameter 1..2 = 1
    CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8,
    CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16  : Discrete Parameter "OFF", "ON" = "ON"

Initialization
    //OpenLogWindow()
    SetDisplayMessage("Copyright (c) 2026 Paulo V. C. Medeiros")
    SetInfoMessage(<<<
        Send MODX AF1 or AF2 state per MIDI channel.
    >>>)
End


On ParameterValueChanged(param : Discrete, index : Integer)
    Matching CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8, CH9,
    CH10, CH11, CH12, CH13, CH14, CH15, CH16

    var channel : Integer = index + 1
    message : MidiMessage
    CC_Number : Integer
    CC_Value : Integer

    If AF_Button == 1 Then
        CC_Number = 86
    Else
        CC_Number = 87
    End

    If param == "OFF" Then
        CC_Value = 0
    Else
        CC_Value = 127
    End

    message = MakeControlChangeMessageEx(CC_Number, CC_Value, channel)
    SendNow(message)
End
