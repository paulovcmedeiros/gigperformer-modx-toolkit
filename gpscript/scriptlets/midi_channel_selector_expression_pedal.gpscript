Const
    // The MIDI center value is always 64.
    // We use a constant to avoid repeating this as a "magic number".
    MIDI_CC_CENTER_VALUE : Integer = 64

    // Add these bit values to select multiple output signals for a channel.
    SIGNAL_EXPRESSION : Integer = 1
    SIGNAL_MODULATION : Integer = 2
    SIGNAL_AFTERTOUCH : Integer = 4
    SIGNAL_CUTOFF : Integer = 8
    SIGNAL_PITCH : Integer = 16
    SIGNAL_BREATH_CONTROLLER : Integer = 32

Var
    pedalValueCH01, pedalValueCH02, pedalValueCH03, pedalValueCH04,
    pedalValueCH05, pedalValueCH06, pedalValueCH07, pedalValueCH08,
    pedalValueCH09, pedalValueCH10, pedalValueCH11, pedalValueCH12,
    pedalValueCH13, pedalValueCH14, pedalValueCH15, pedalValueCH16 : Subrange Parameter 0..127 = 0

    OutputSignalCH01, OutputSignalCH02, OutputSignalCH03, OutputSignalCH04,
    OutputSignalCH05, OutputSignalCH06, OutputSignalCH07, OutputSignalCH08,
    OutputSignalCH09, OutputSignalCH10, OutputSignalCH11, OutputSignalCH12,
    OutputSignalCH13, OutputSignalCH14, OutputSignalCH15, OutputSignalCH16
        : Subrange Parameter 0..63 = 0

    CCToRemapAsCenter : Subrange Parameter 1..126 = MIDI_CC_CENTER_VALUE

Var
    currentPedalValue : Integer = 0
    hasReceivedPedalValue : Boolean = false

    isExprPedalActiveAtChannel : Boolean Array = [
        false, false, false, false, false, false, false, false,
        false, false, false, false, false, false, false, false
    ]
    channelPedalValues : Subrange Array = [
        pedalValueCH01, pedalValueCH02, pedalValueCH03, pedalValueCH04,
        pedalValueCH05, pedalValueCH06, pedalValueCH07, pedalValueCH08,
        pedalValueCH09, pedalValueCH10, pedalValueCH11, pedalValueCH12,
        pedalValueCH13, pedalValueCH14, pedalValueCH15, pedalValueCH16
    ]
    channelSignals : Subrange Array = [
        OutputSignalCH01, OutputSignalCH02, OutputSignalCH03, OutputSignalCH04,
        OutputSignalCH05, OutputSignalCH06, OutputSignalCH07, OutputSignalCH08,
        OutputSignalCH09, OutputSignalCH10, OutputSignalCH11, OutputSignalCH12,
        OutputSignalCH13, OutputSignalCH14, OutputSignalCH15, OutputSignalCH16
    ]
    availableSignalFlags : Integer Array = [
        SIGNAL_EXPRESSION,
        SIGNAL_MODULATION,
        SIGNAL_AFTERTOUCH,
        SIGNAL_CUTOFF,
        SIGNAL_PITCH,
        SIGNAL_BREATH_CONTROLLER
    ]

Const
    EXPR_PEDAL_CC_NUMBER : Integer = 11


Function UpdateListOfExprActiveChannels()
    // Cache which MIDI channels should react to incoming expression pedal values.
    Var
        iChZeroBased : Integer

    For iChZeroBased=0; iChZeroBased<16; iChZeroBased=iChZeroBased+1 Do
        isExprPedalActiveAtChannel[iChZeroBased] = channelSignals[iChZeroBased] != 0
    End
End


Function ResetValuesForInactiveChannels()
    // Clear displayed values for channels that are not using the pedal.
    Var
        iChZeroBased : Integer

    For iChZeroBased=0; iChZeroBased<16; iChZeroBased=iChZeroBased+1 Do
        If !isExprPedalActiveAtChannel[iChZeroBased] Then
            channelPedalValues[iChZeroBased] = 0
        End
    End
End


Function SendSignal(signalFlag : Integer, signalValue: Integer, channel : Integer)
    // Send the expression pedal value as the selected MIDI signal on channel.
    Var
        ccNumber : Integer
        ccMessage : ControlChangeMessage
        pbMessage : PitchBendMessage
        atMessage : AfterTouchMessage

    Select
        signalFlag == SIGNAL_MODULATION        do ccNumber = 1
        signalFlag == SIGNAL_BREATH_CONTROLLER do ccNumber = 2
        signalFlag == SIGNAL_EXPRESSION        do ccNumber = 11
        signalFlag == SIGNAL_CUTOFF            do ccNumber = 74
        True                                   do ccNumber = 0
    End

    If ccNumber > 0 Then
        ccMessage = MakeControlChangeMessageEx(ccNumber, signalValue, channel)
        SendNow(ccMessage)
    Else
        Select
            signalFlag == SIGNAL_PITCH do
                If signalValue==63 Or signalValue==64 Then
                    signalValue = 8192 // Pitch-bend center
                Else
                    signalValue = ScaleInt (signalValue, 0, 127, 0, 16383)
                End
                pbMessage = MakePitchBendMessageEx(signalValue, channel)
                SendNow(pbMessage)
            signalFlag == SIGNAL_AFTERTOUCH do
                atMessage = MakeAfterTouchMessageEx(signalValue, channel)
                SendNow(atMessage)
        End
    End
End


Function GetSignalResetValue(signalFlag : Integer) Returns Integer
    // Return the neutral MIDI value for a signal that is no longer selected.
    // These values assume conventional MIDI destinations; custom or inverted
    // mappings may require different neutral values.
    Select
        signalFlag == SIGNAL_EXPRESSION do result = 127
        signalFlag == SIGNAL_CUTOFF     do result = MIDI_CC_CENTER_VALUE
        signalFlag == SIGNAL_PITCH      do result = MIDI_CC_CENTER_VALUE
        True                            do result = 0
    End
End


Function ResetRemovedSignals(previousSignalMask : Integer, signalMask : Integer, channel : Integer)
    // Reset only signals that were selected in the previous channel mask.
    Var
        iSignal : Integer
        signalFlag : Integer
        wasSelected, isSelected : Boolean

    For iSignal=0; iSignal<Size(availableSignalFlags); iSignal=iSignal+1 Do
        signalFlag = availableSignalFlags[iSignal]
        wasSelected = (previousSignalMask And signalFlag) != 0
        isSelected = (signalMask And signalFlag) != 0

        If wasSelected And !isSelected Then
            SendSignal(signalFlag, GetSignalResetValue(signalFlag), channel)
        End
    End
End


Function SendAddedSignals(previousSignalMask : Integer, signalMask : Integer, signalValue : Integer, channel : Integer)
    // Send the current pedal value only as signals newly added to a channel mask.
    Var
        iSignal : Integer
        signalFlag : Integer
        wasSelected, isSelected : Boolean

    For iSignal=0; iSignal<Size(availableSignalFlags); iSignal=iSignal+1 Do
        signalFlag = availableSignalFlags[iSignal]
        wasSelected = (previousSignalMask And signalFlag) != 0
        isSelected = (signalMask And signalFlag) != 0

        If !wasSelected And isSelected Then
            SendSignal(signalFlag, signalValue, channel)
        End
    End
End


Function ResetSelectedSignalsForAllChannels()
    // Reset every signal selected in the current channel masks.
    Var
        iChZeroBased : Integer

    For iChZeroBased=0; iChZeroBased<16; iChZeroBased=iChZeroBased+1 Do
        ResetRemovedSignals(channelSignals[iChZeroBased], 0, iChZeroBased + 1)
    End
End


Function RemapPedalCenterValue(x : Integer) Returns Integer
    // Remap the configured pedal CC value to the MIDI center value.
    // Below and above that point are scaled independently.
    Var
        a, b : Double

    If x <= CCToRemapAsCenter Then
        a = IntToFloat(MIDI_CC_CENTER_VALUE) / IntToFloat(CCToRemapAsCenter)
        b = 0.0
    Else
        a = (127 - IntToFloat(MIDI_CC_CENTER_VALUE)) / (127 - IntToFloat(CCToRemapAsCenter))
        b = 127 * (1 - a)
    End

    result = Round(a*x + b)
End


//--------------------------------------------------
Initialization
    //OpenLogWindow()
    SetDisplayMessage("Copyright (c) 2026 Paulo V. C. Medeiros")
    SetInfoMessage(<<<
    Remap inputs from one expression pedal to the selected MIDI signals per channel.
    Supports Expression, Modulation, Pitch Bend, Cutoff, Aftertouch, and Breath Controller.
    Selected signals are reset on rackspace activation and when removed from a channel.
    Conventional reset values are used: Expression=127, Cutoff=64, Pitch Bend=center, and others=0.
    Signal bit values:
        * Expression        =  1
        * Modulation        =  2
        * Aftertouch        =  4
        * Cutoff            =  8
        * Pitch             = 16
        * Breath Controller = 32
    Examples:
      0 = OFF
      5 = Expression + Aftertouch
      7 = Expression + Modulation + Aftertouch
      10 = Modulation + Cutoff
      19 = Expression + Modulation + Pitch
      63 = All available signals
    >>>)
    UpdateListOfExprActiveChannels()
    ResetValuesForInactiveChannels()
End


On Activate
    hasReceivedPedalValue = false
    // Reset here because scriptlet MIDI output is unavailable by On Deactivate.
    ResetSelectedSignalsForAllChannels()
    UpdateListOfExprActiveChannels()
    ResetValuesForInactiveChannels()
End


On ParameterValueChanged(param_value : Subrange, index : Integer)
    Matching
        OutputSignalCH01, OutputSignalCH02, OutputSignalCH03, OutputSignalCH04,
        OutputSignalCH05, OutputSignalCH06, OutputSignalCH07, OutputSignalCH08,
        OutputSignalCH09, OutputSignalCH10, OutputSignalCH11, OutputSignalCH12,
        OutputSignalCH13, OutputSignalCH14, OutputSignalCH15, OutputSignalCH16

    Var
        previousSignalMask : Integer = GetSubrangePreviousValue(param_value)
        signalMask : Integer = param_value
        channel : Integer = index + 1

    ResetRemovedSignals(previousSignalMask, signalMask, channel)
    If hasReceivedPedalValue Then
        SendAddedSignals(previousSignalMask, signalMask, currentPedalValue, channel)
        If previousSignalMask == 0 And signalMask != 0 Then
            channelPedalValues[index] = currentPedalValue
        End
    End
    UpdateListOfExprActiveChannels()
    ResetValuesForInactiveChannels()
End


On ControlChangeEvent(m : ControlChangeMessage) Matching EXPR_PEDAL_CC_NUMBER
    Var
        iCh : Integer
        ccValue : Integer = GetCCValue(m)
        remappedCC : Integer = RemapPedalCenterValue(ccValue)

    currentPedalValue = remappedCC
    hasReceivedPedalValue = true

    // Drive every active channel parameter from the same physical pedal value.
    For iCh=0; iCh<16; iCh=iCh+1 Do
        If isExprPedalActiveAtChannel[iCh] Then
            channelPedalValues[iCh] = remappedCC
        End
    End
End


On ParameterValueChanged(param_value : Subrange, index : Integer)
    Matching
        pedalValueCH01, pedalValueCH02, pedalValueCH03, pedalValueCH04,
        pedalValueCH05, pedalValueCH06, pedalValueCH07, pedalValueCH08,
        pedalValueCH09, pedalValueCH10, pedalValueCH11, pedalValueCH12,
        pedalValueCH13, pedalValueCH14, pedalValueCH15, pedalValueCH16

    Var
        iSignal : Integer
        signalFlag : Integer
        channel : Integer = index + 1
        signalValue : Integer = param_value


    If isExprPedalActiveAtChannel[index] Then
        // Each channel can emit all selected signal types from the same value.
        For iSignal=0; iSignal<Size(availableSignalFlags); iSignal=iSignal+1 Do
            signalFlag = availableSignalFlags[iSignal]
            If (channelSignals[index] And signalFlag) != 0 Then
                SendSignal(signalFlag, signalValue, channel)
            End
        End
    End
End
