Var
    MainSwitch: Discrete Parameter "OFF", "ON" = "ON"
    CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8,
    CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16 : Discrete Parameter "OFF", "ON" = "OFF"

Var
    channelSwitches : Discrete Array = [
        CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8,
        CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16
    ]


Function IsReleaseMessage(m : MidiMessage) Returns Boolean
    // Return whether m releases notes or resets controllers.
    Var
        isCC : Boolean = IsController(m)
        cc : ControlChangeMessage
        ccNumber, ccValue : Integer

    If isCC Then
        cc = ReinterpretAsControllerMessage(m)
        ccNumber = GetCCNumber(cc)
        ccValue = GetCCValue(cc)
    End

    result = IsNoteOff(m)
        Or (IsNoteOn(m) And (GetByte(m, 2) == 0))
        Or (isCC And (ccNumber == 64) And (ccValue < 64))  // Sustain Pedal Off
        Or (isCC And (ccNumber == 120))                    // All Sound Off
        Or (isCC And (ccNumber == 121))                    // Reset All Controllers
        Or (isCC And (ccNumber == 123))                    // All Notes Off
End


//------------------------------------

Initialization
    //OpenLogWindow()
    SetDisplayMessage("Copyright (c) 2026 Paulo V. C. Medeiros")
    SetInfoMessage(<<<
        Allow or mute MIDI by channel.
    >>>)
End


On MidiEvent(m : MidiMessage)
    Var
        channel : Integer = GetChannel(m)
        index : Integer = channel - 1
        channel_is_allowed : Boolean = channelSwitches[index] == "ON"

    If ((MainSwitch == "ON") And channel_is_allowed) Or IsReleaseMessage(m) Then
        SendNow(m)
    End
End
