var
   MainSwitch: Discrete Parameter "OFF", "ON" = "ON"
   CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8 : Discrete Parameter "OFF", "ON" = "OFF"
   CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16  : Discrete Parameter "OFF", "ON" = "OFF"


Initialization
   //OpenLogWindow()
   SetDisplayMessage("Copyright (c) 2025 Pauo V. C. Medeiros")
   SetInfoMessage(<<<
       Read note on/off status from incoming messsages at each MIDI channel.
   >>>)
End

   
Function KillAllNotes(channel : Integer)
    SendNow(MakeControlChangeMessageEx(123, 0, channel))  // All Notes Off
    SendNow(MakeControlChangeMessageEx(64, 0, channel))  // Sustain Pedal Off
End


// Kill all sound if the channel gets disabled
On ParameterValueChanged(param_value : Discrete, index : Integer)
    Matching 
        MainSwitch
   
    var channel : Integer = index

    If MainSwitch == "OFF" Then
        For channel=1; channel<=16; channel=channel+1 Do
            KillAllNotes(channel)
        End
    End
End


//Called when a NoteOn or NoteOff message is received
//Note: this will NOT be called for NoteOn/NoteOff messages if you have explicit
//NoteOnEvent/NoteOffEvent respectively callbacks defined
On MidiEvent(m : MidiMessage)
    var channel : Integer
    var channel_is_allowed, main_switch_is_on : Boolean = false
    

    channel = GetChannel(m)
    Select
        (channel ==  1) do channel_is_allowed = (CH1  == "ON")
        (channel ==  2) do channel_is_allowed = (CH2  == "ON")
        (channel ==  3) do channel_is_allowed = (CH3  == "ON")
        (channel ==  4) do channel_is_allowed = (CH4  == "ON")
        (channel ==  5) do channel_is_allowed = (CH5  == "ON")
        (channel ==  6) do channel_is_allowed = (CH6  == "ON")
        (channel ==  7) do channel_is_allowed = (CH7  == "ON")
        (channel ==  8) do channel_is_allowed = (CH8  == "ON")
        (channel ==  9) do channel_is_allowed = (CH9  == "ON")
        (channel == 10) do channel_is_allowed = (CH10 == "ON")
        (channel == 11) do channel_is_allowed = (CH11 == "ON")
        (channel == 12) do channel_is_allowed = (CH12 == "ON")
        (channel == 13) do channel_is_allowed = (CH13 == "ON")
        (channel == 14) do channel_is_allowed = (CH14 == "ON")
        (channel == 15) do channel_is_allowed = (CH15 == "ON")
        (channel == 16) do channel_is_allowed = (CH16 == "ON")
    End

    main_switch_is_on = (MainSwitch == "ON")
    If (main_switch_is_on and channel_is_allowed) or IsNoteOff(m) Then
        SendNow(m)
    End

End
