var
    // 1 Preset, 8 User, 8 Library banks, mapped from 0 to 16
    LiveSetBank : Subrange Parameter 0..16 = 1
    Page : Subrange Parameter 1..16 = 1
    Col : Parameter "A", "B", "C", "D" = "A"
    Row : Subrange Parameter 1..4 = 1
    AutoPartNamesSyncSwitch : Subrange Parameter 0..1 = 1

var
    partNameRequestDueDatetime : Double = 0.0
    partNameRequestSendDelayInMs : Double = 100.0
    waitingToSendPartNameRequest : Boolean = false


Function ColLetterToNumber(colLetter : String) Returns Integer
    Select
        colLetter == "A" Do result = 1
        colLetter == "B" Do result = 2
        colLetter == "C" Do result = 3
        colLetter == "D" Do result = 4
    End
End


Function RequestCurrentPerformanceName()
    Var
        perf_name_request : SysexMessage = # F0 43 30 7F 1C 07 30 40 00 F7
        i : Integer

    Const
        N_CHARS_IN_NAME : Integer = 20

    For i = 0; i <= (N_CHARS_IN_NAME - 1); i = i + 1 Do
        SM_ChangeValue(perf_name_request, 8, i)
        SendSysexNow(perf_name_request)
    End
End


Function RequestPerformancePartNames()
    Var
        voice_name_sysex_request_msg        : SysexMessage = # F0 43 20 7F 1C 07 0E 52 00 F7
        part_switch_state_sysex_request_msg : SysexMessage = # F0 43 30 7F 1C 07 31 00 16 F7
        partIndex : Integer

    Const
        PART_INDEX_BYTE : Integer = 8
        PART_SWITCH_STATUS_INDEX_BYTE : Integer = 7

    For partIndex = 0; partIndex <= 7; partIndex = partIndex + 1 Do
        SM_ChangeValue(part_switch_state_sysex_request_msg, PART_SWITCH_STATUS_INDEX_BYTE, partIndex)
        SendSysexNow(part_switch_state_sysex_request_msg)
    End

    For partIndex = 0; partIndex <= 7; partIndex = partIndex + 1 Do
        SM_ChangeValue(voice_name_sysex_request_msg, PART_INDEX_BYTE, partIndex)
        SendSysexNow(voice_name_sysex_request_msg)
    End
End


Function ScheduleRequestAllParts()
    waitingToSendPartNameRequest = true
    partNameRequestDueDatetime = TimeSinceStartup() + partNameRequestSendDelayInMs
    SetTimersRunning(true)
End


function SelectMODXLiveSetBank(liveSetBank : Integer)
    var
        msg : SysexMessage

    // SysEx to change Live Set Bank: # F0 43 10 7F 1C 07 09 00 00 XX F7
    //   xx = 0x00: Preset Live Set
    //   xx = 0x01..0x08: User Live Set 1..8
    //   xx = 0x09..0x10: Library Live Set 1..8, depending on loaded libraries
    msg = # F0 43 10 7F 1C 07 09 00 00 00 F7
    if liveSetBank >= 0 and liveSetBank <= 16 then
        SM_ChangeValue(msg, 9, liveSetBank)
        SendSysexNow(msg)
    end
end


Function SendPerformanceChangeMsg()
    var
        Slot : Integer = 4*(Row - 1) + ColLetterToNumber(Col)
        MSBLiveSet : Integer = 62  // Current Live Set bank; MODX does not switch Live Set banks via this
        LSB : Integer = Page - 1
        PC  : Integer = Slot - 1

    SelectMODXLiveSetBank(LiveSetBank)
    SendNow(MakeControlChangeMessage(0, MSBLiveSet))
    SendNow(MakeControlChangeMessage(32, LSB))
    SendNow(MakeProgramChangeMessage(PC))

    If AutoPartNamesSyncSwitch > 0 Then
        ScheduleRequestAllParts()
    End
End

//---------------------------------------------------------------------
Initialization
    //OpenLogWindow()
    SetDisplayMessage("Copyright (c) 2026 Paulo V. C. Medeiros")
    SetInfoMessage(<<<
        Select MODX Live Set performances and sync names.
    >>>)
    SendPerformanceChangeMsg()
End


On Activate
    //OpenLogWindow()
    SendPerformanceChangeMsg()
End


On ParameterValueChanged matching Col
    SendPerformanceChangeMsg()
End


On ParameterValueChanged matching LiveSetBank, Page, Row
    SendPerformanceChangeMsg()
End


On ParameterValueChanged matching AutoPartNamesSyncSwitch
    If AutoPartNamesSyncSwitch > 0 Then
        SendPerformanceChangeMsg()
    End
End


On TimerTick(ms : Double)
    If waitingToSendPartNameRequest And (TimeSinceStartup() >= partNameRequestDueDatetime) Then
        waitingToSendPartNameRequest = false
        SetTimersRunning(false)

        RequestPerformancePartNames()
        RequestCurrentPerformanceName()
    End
End
