Var
    CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8,
    CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16 : Subrange Parameter 0..127 = 0

Var
    channelVelocities : Subrange Array = [
        CH1, CH2, CH3, CH4, CH5, CH6, CH7, CH8,
        CH9, CH10, CH11, CH12, CH13, CH14, CH15, CH16
    ]


Function SetParameterValue(channel : Integer, newParamValue : Integer)
    // Set the displayed velocity value for channel.
    channelVelocities[channel - 1] = newParamValue
End


//------------------------------------

Initialization
    //OpenLogWindow()
    SetDisplayMessage("Copyright (c) 2026 Paulo V. C. Medeiros")
    SetInfoMessage(<<<
        Show per-channel note velocity values.
    >>>)
End


On NoteEvent(m : NoteMessage)
    SendNow(m)
    SetParameterValue(GetChannel(m), GetVelocity(m))
End


On ControlChangeEvent(m : ControlChangeMessage) Matching 123  // All Notes Off
    SendNow(m)
    SetParameterValue(GetChannel(m), 0)
End
