// Toggle a local OSC value whenever the current song changes.
// This expects an OSC-addressable target at /SongChangeTrigger/SetValue,
// typically a widget whose handle is SongChangeTrigger.

Var
    SongChangeToggle : Boolean = false
    ValueToBeSent : Double = 0.0

On Song(oldSongIndex : Integer, newSongIndex : Integer)

    SongChangeToggle = !SongChangeToggle

    If SongChangeToggle Then
        ValueToBeSent = 1.0
    Else
        ValueToBeSent = 0.0
    End

    OSC_SendDoubleSpecific(
    "/SongChangeTrigger/SetValue",
    ValueToBeSent,
    "127.0.0.1",
    OSC_GetGPListeningPort()
    )

End
